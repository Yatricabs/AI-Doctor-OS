# Copy this file to .env.local and fill in your real values. Never commit .env.local.

# ── Supabase (server-side API routes) ────────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-or-publishable-key>

# ── Postgres connection ──────────────────────────────────────────────────────
# IMPORTANT: use the IPv4 connection *pooler* host, not the direct db.<ref>.supabase.co
# host. The direct host is IPv6-only and fails on serverless platforms like Vercel.
# Find it in: Supabase Dashboard → Project Settings → Database → Connection pooling.
# URL-encode the password if it contains special characters such as "@".
DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
