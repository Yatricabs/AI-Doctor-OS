{
  "name": "ai-doctor-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-css.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:clinical-report-renderer": "node --experimental-strip-types scripts/clinical-report-renderer-contract-tests.mjs",
    "test:clinical-report-renderer:semantic": "node scripts/clinical-report-renderer-semantic-state-tests.mjs",
    "test:appointment-adaptive-interview": "node --experimental-strip-types scripts/appointment-adaptive-interview-tests.mjs",
    "test:appointment-intake-context": "node --experimental-strip-types scripts/appointment-intake-context-tests.mjs",
    "test:appointment-intake-browser": "node scripts/appointment-intake-browser-tests.mjs",
    "test:medical-knowledge-retrieval": "node --experimental-strip-types scripts/medical-knowledge-retrieval-tests.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.2.7",
    "@supabase/supabase-js": "^2.49.1",
    "better-sqlite3": "^11.7.0",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "9.1.2"
  },
  "comment_allowScripts": "npm v12+ blocks dependency install scripts by default. better-sqlite3 is a native module whose install script fetches/compiles its .node binary; without this it fails to load at runtime and every API route returns a 500. Name-only entries allow any version so lockfile updates do not re-break the build.",
  "allowScripts": {
    "better-sqlite3": true,
    "unrs-resolver": true
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
