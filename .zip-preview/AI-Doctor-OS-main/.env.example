# Supabase project settings for server-side API routes (optional).
# The app works fully without these -- data lives in an in-memory store by
# default. Set both to also mirror every write to Supabase Postgres for
# durable storage across cold starts / redeploys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Puter.js AI (optional). Powers AI Scribe, Copilot, medical-record
# summarize/analyze, and symptom-checker follow-up questions with a real
# model. Without this, those routes fall back to canned demo responses --
# nothing crashes or breaks if it's unset. Get a token at
# https://puter.com/dashboard -> API token section -> Create token.
# NOTE: this routes data through a third-party AI proxy -- fine for demo/seed
# data, but real patient information (PHI) would need its own data-processing
# agreement with the underlying model provider before production use.
PUTER_AUTH_TOKEN=your-puter-api-token
# Optional -- defaults to gpt-5.4-nano if unset.
PUTER_MODEL=gpt-5.4-nano
